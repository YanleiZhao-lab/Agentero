{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentero",
  "version": "0.18.2",
  "identifier": "com.poco-ai.agentero",
  "build": {
    "beforeDevCommand": "pnpm cli:bundle && pnpm dictionary:stage && pnpm pdfium:stage && pnpm adapters:stage && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm cli:bundle:release && pnpm dictionary:stage && pnpm pdfium:stage && pnpm adapters:stage && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgenteroZ 定制自用版",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 800,
        "minWidth": 700,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNUYyMzVGQjYyNUNBQjEKUldTeHlpVzJYeU5mNGN2VU83Nm9sWVBWeTI1Zmw0S21Xa2k1WUNSMHNJY3BUV2lFemlDNjhyL1MK",
      "endpoints": [
        "https://github.com/YanleiZhao-lab/Agentero/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "agentero"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "agentero"
          ],
          "appLink": false
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Productivity",
    "externalBin": [],
    "resources": [
      "cli",
      "pdfium/*",
      "adapters/**/*",
      "rtex/tex/**/*",
      "dictionary/*"
    ],
    "icon": [
      "icons/agenteroz/32x32.png",
      "icons/agenteroz/128x128.png",
      "icons/agenteroz/128x128@2x.png",
      "icons/agenteroz/icon.icns",
      "icons/agenteroz/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "sidebarImage": "icons/agenteroz/nsis-sidebar.bmp",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
